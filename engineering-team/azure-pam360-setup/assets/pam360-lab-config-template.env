# PAM360 Lab Configuration Template
# Copy to .env, fill in values, then: source .env before running scripts
# NEVER commit this file with real values

# Azure region where all resources are deployed
LOCATION=eastus

# Resource group name (all lab resources live here)
RESOURCE_GROUP=rg-pam360-lab

# Local admin account on all VMs (NOT an Entra ID account)
ADMIN_USERNAME=pamadmin

# Strong password: 12+ chars, upper + lower + digit + special
# Example pattern: PAM360Lab@2024!  (change this)
ADMIN_PASSWORD=

# Number of Windows endpoint VMs to create (default: 2)
ENDPOINT_COUNT=2

# VNet and subnet names (match what scripts create by default)
VNET_NAME=vnet-pam360
SUBNET_PAM=snet-pam-server
SUBNET_ENDPOINTS=snet-endpoints

# VM names (auto-set by scripts; override only if needed)
PAM_VM_NAME=vm-pam360-server

# Storage account name (auto-generated by script 01; set here if re-running scripts)
STORAGE_ACCOUNT=
